// Signup records for the Launch Point Global Tour.
//
// DATABASE_URL is the pooled connection the serverless functions use.
// DIRECT_URL is the unpooled one, needed only for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Signup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Written when checkout starts, updated when Stripe confirms payment.
  stripeSessionId String  @unique
  paymentIntentId String?
  status          String  @default("pending") // pending | paid | expired

  club     String
  platform String // sgt | trackman
  tour     String // fall | winter | spring | bundle

  playerName String
  email      String
  phone      String

  // Split is stored so the pot and the card fee stay separable later.
  buyInCents Int
  feeCents   Int
  totalCents Int

  paidAt DateTime?

  @@index([tour, platform])
  @@index([club])
  @@index([status])
}

// Clubs registering interest in the tour. Free, no payment involved.
model ClubApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  facility      String
  contactName   String
  email         String
  phone         String
  city          String // free text: city / state / country
  launchMonitor String // what they run, e.g. "Uneekor EyeXO2"
  interest      String // yes | maybe | not_now
  notes         String?

  // Derived once we know it, so a club can be matched to the right series.
  platform String? // sgt | trackman

  @@index([interest])
  @@index([createdAt])
}
